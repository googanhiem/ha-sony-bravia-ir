@@ -0,0 +1,18 @@
+"""Tests for the Sony Bravia Infrared integration."""
+
+from infrared_protocols.codes.sony.tv import (
+    SONY_TV_ADDRESS,
+    SONY_TV_ADDRESS_BITS,
+    SonyTVCode,
+)
+from infrared_protocols.commands import Command
+from infrared_protocols.commands.sony import SonyCommand
+
+
+def assert_sony_tv_command(command: Command, code: SonyTVCode) -> None:
+    """Assert that a command is a three-frame key press of a Sony TV code."""
+    assert isinstance(command, SonyCommand)
+    assert command.address == SONY_TV_ADDRESS
+    assert command.address_bits == SONY_TV_ADDRESS_BITS
+    assert command.command == code
+    assert command.repeat_count == 2
