diff --git a/tests/components/sony_bravia_infrared/test_button.py b/tests/components/sony_bravia_infrared/test_button.py
new file mode 100644
index 00000000..df360dd8
--- /dev/null
+++ b/tests/components/sony_bravia_infrared/test_button.py
@@ -0,0 +1,113 @@
+"""Tests for the Sony Bravia Infrared button platform."""
+
+from infrared_protocols.codes.sony.tv import SonyTVCode
+import pytest
+from pytest_homeassistant.common import MockConfigEntry, snapshot_platform
+from pytest_homeassistant.components.common import (
+    assert_availability_follows_source_entity,
+)
+from pytest_homeassistant.components.infrared import EMITTER_ENTITY_ID
+from pytest_homeassistant.components.infrared.common import MockInfraredEmitterEntity
+from syrupy.assertion import SnapshotAssertion
+
+from homeassistant.components.button import DOMAIN as BUTTON_DOMAIN, ButtonService
+from homeassistant.const import CommonServiceArgument, Platform
+from homeassistant.core import HomeAssistant
+from homeassistant.helpers import device_registry as dr, entity_registry as er
+
+from . import assert_sony_tv_command
+
+
+@pytest.fixture
+def platforms() -> list[Platform]:
+    """Return platforms to set up."""
+    return [Platform.BUTTON]
+
+
+@pytest.mark.usefixtures("entity_registry_enabled_by_default", "init_integration")
+async def test_entities(
+    hass: HomeAssistant,
+    snapshot: SnapshotAssertion,
+    entity_registry: er.EntityRegistry,
+    device_registry: dr.DeviceRegistry,
+    mock_config_entry: MockConfigEntry,
+) -> None:
+    """Test all button entities are created with the expected attributes."""
+    await snapshot_platform(hass, entity_registry, snapshot, mock_config_entry.entry_id)
+
+    device_entry = device_registry.async_get_device_by_identifier(
+        ("sony_bravia_infrared", mock_config_entry.entry_id),
+        mock_config_entry.entry_id,
+    )
+    assert device_entry
+    entity_entries = er.async_entries_for_config_entry(
+        entity_registry, mock_config_entry.entry_id
+    )
+    assert len(entity_entries) == len(SonyTVCode)
+    for entity_entry in entity_entries:
+        assert entity_entry.device_id == device_entry.id
+
+
+@pytest.mark.parametrize(
+    ("entity_id", "expected_code"),
+    [
+        ("button.sony_bravia_tv_power", SonyTVCode.POWER),
+        ("button.sony_bravia_tv_input", SonyTVCode.INPUT),
+        ("button.sony_bravia_tv_up", SonyTVCode.NAV_UP),
+        ("button.sony_bravia_tv_ok", SonyTVCode.OK),
+        ("button.sony_bravia_tv_home", SonyTVCode.HOME),
+        ("button.sony_bravia_tv_number_0", SonyTVCode.NUM_0),
+        ("button.sony_bravia_tv_number_1", SonyTVCode.NUM_1),
+        ("button.sony_bravia_tv_red", SonyTVCode.RED),
+    ],
+)
+@pytest.mark.usefixtures("entity_registry_enabled_by_default", "init_integration")
+async def test_button_press_sends_correct_code(
+    hass: HomeAssistant,
+    mock_infrared_emitter_entity: MockInfraredEmitterEntity,
+    entity_id: str,
+    expected_code: SonyTVCode,
+) -> None:
+    """Test pressing a button sends the correct IR code."""
+    await hass.services.async_call(
+        BUTTON_DOMAIN,
+        ButtonService.PRESS,
+        {CommonServiceArgument.ENTITY_ID: entity_id},
+        blocking=True,
+    )
+
+    assert len(mock_infrared_emitter_entity.send_command_calls) == 1
+    assert_sony_tv_command(
+        mock_infrared_emitter_entity.send_command_calls[0], expected_code
+    )
+
+
+@pytest.mark.parametrize(
+    ("entity_id", "disabled_by"),
+    [
+        ("button.sony_bravia_tv_power", None),
+        ("button.sony_bravia_tv_volume_up", None),
+        ("button.sony_bravia_tv_number_5", er.RegistryEntryDisabler.INTEGRATION),
+        ("button.sony_bravia_tv_blue", er.RegistryEntryDisabler.INTEGRATION),
+    ],
+)
+@pytest.mark.usefixtures("init_integration")
+async def test_buttons_disabled_by_default(
+    entity_registry: er.EntityRegistry,
+    entity_id: str,
+    disabled_by: er.RegistryEntryDisabler | None,
+) -> None:
+    """Test less common keys are disabled by default and core keys are not."""
+    entity_entry = entity_registry.async_get(entity_id)
+    assert entity_entry
+    assert entity_entry.disabled_by is disabled_by
+
+
+@pytest.mark.usefixtures("init_integration")
+async def test_button_availability_follows_ir_entity(
+    hass: HomeAssistant,
+) -> None:
+    """Test a button becomes unavailable when the emitter is unavailable."""
+    await assert_availability_follows_source_entity(
+        hass, "button.sony_bravia_tv_power", [EMITTER_ENTITY_ID]
+    )
diff --git a/tests/components/sony_bravia_infrared/test_config_flow.py b/tests/components/sony_bravia_infrared/test_config_flow.py
new file mode 100644
index 00000000..b6ba8106
--- /dev/null
+++ b/tests/components/sony_bravia_infrared/test_config_flow.py
@@ -0,0 +1,285 @@
+"""Tests for the Sony Bravia Infrared config flow."""
+
+import pytest
+from pytest_homeassistant.common import MockConfigEntry, get_schema_suggested_value
+from pytest_homeassistant.components.infrared import (
+    EMITTER_ENTITY_ID,
+    RECEIVER_ENTITY_ID,
+)
+from pytest_homeassistant.components.infrared.common import MockInfraredEmitterEntity
+
+from homeassistant.components.infrared import DATA_COMPONENT as INFRARED_DATA_COMPONENT
+from homeassistant.components.sony_bravia_infrared.const import (
+    CONF_INFRARED_ENTITY_ID,
+    CONF_INFRARED_RECEIVER_ENTITY_ID,
+    DOMAIN,
+)
+from homeassistant.config_entries import SOURCE_USER
+from homeassistant.core import HomeAssistant
+from homeassistant.data_entry_flow import FlowResultType
+from homeassistant.helpers import entity_registry as er
+
+SECOND_EMITTER_ENTITY_ID = "infrared.second_ir_emitter"
+UNREGISTERED_EMITTER_ENTITY_ID = "infrared.unregistered_ir_emitter"
+
+
+@pytest.mark.parametrize(
+    ("user_input", "expected_title"),
+    [
+        pytest.param(
+            {CONF_INFRARED_ENTITY_ID: EMITTER_ENTITY_ID},
+            "Sony Bravia TV via Test IR emitter",
+            id="emitter_only",
+        ),
+        pytest.param(
+            {
+                CONF_INFRARED_ENTITY_ID: EMITTER_ENTITY_ID,
+                CONF_INFRARED_RECEIVER_ENTITY_ID: RECEIVER_ENTITY_ID,
+            },
+            "Sony Bravia TV via Test IR emitter",
+            id="emitter_and_receiver",
+        ),
+        pytest.param(
+            {CONF_INFRARED_RECEIVER_ENTITY_ID: RECEIVER_ENTITY_ID},
+            "Sony Bravia TV via Test IR receiver",
+            id="receiver_only",
+        ),
+    ],
+)
+@pytest.mark.usefixtures(
+    "mock_infrared_emitter_entity", "mock_infrared_receiver_entity", "mock_setup_entry"
+)
+async def test_user_flow(
+    hass: HomeAssistant,
+    user_input: dict[str, str],
+    expected_title: str,
+) -> None:
+    """Test a successful user flow."""
+    result = await hass.config_entries.flow.async_init(
+        DOMAIN, context={"source": SOURCE_USER}
+    )
+    assert result["type"] is FlowResultType.FORM
+    assert result["step_id"] == "user"
+    assert result["errors"] == {}
+
+    result = await hass.config_entries.flow.async_configure(
+        result["flow_id"], user_input=user_input
+    )
+
+    assert result["type"] is FlowResultType.CREATE_ENTRY
+    assert result["title"] == expected_title
+    assert result["data"] == user_input
+    assert result["result"].unique_id is None
+
+
+@pytest.mark.usefixtures("mock_infrared_emitter_entity", "mock_setup_entry")
+async def test_user_flow_title_uses_entity_registry_name(
+    hass: HomeAssistant,
+    entity_registry: er.EntityRegistry,
+) -> None:
+    """Test the entry title uses a name the user gave the emitter."""
+    entity_registry.async_update_entity(EMITTER_ENTITY_ID, name="Living room blaster")
+
+    result = await hass.config_entries.flow.async_init(
+        DOMAIN, context={"source": SOURCE_USER}
+    )
+    result = await hass.config_entries.flow.async_configure(
+        result["flow_id"], user_input={CONF_INFRARED_ENTITY_ID: EMITTER_ENTITY_ID}
+    )
+
+    assert result["type"] is FlowResultType.CREATE_ENTRY
+    assert result["title"] == "Sony Bravia TV via Living room blaster"
+
+
+@pytest.mark.usefixtures("init_infrared", "mock_setup_entry")
+async def test_user_flow_title_falls_back_to_entity_id(hass: HomeAssistant) -> None:
+    """Test the entry title uses the entity ID when it is not in the registry."""
+    emitter = MockInfraredEmitterEntity("unregistered_ir_emitter", None)
+    emitter._attr_unique_id = None
+    emitter.entity_id = UNREGISTERED_EMITTER_ENTITY_ID
+    await hass.data[INFRARED_DATA_COMPONENT].async_add_entities([emitter])
+
+    result = await hass.config_entries.flow.async_init(
+        DOMAIN, context={"source": SOURCE_USER}
+    )
+    result = await hass.config_entries.flow.async_configure(
+        result["flow_id"],
+        user_input={CONF_INFRARED_ENTITY_ID: UNREGISTERED_EMITTER_ENTITY_ID},
+    )
+
+    assert result["type"] is FlowResultType.CREATE_ENTRY
+    assert result["title"] == f"Sony Bravia TV via {UNREGISTERED_EMITTER_ENTITY_ID}"
+
+
+@pytest.mark.usefixtures("mock_infrared_emitter_entity", "mock_setup_entry")
+async def test_user_flow_requires_emitter_or_receiver(hass: HomeAssistant) -> None:
+    """Test the flow shows an error when neither an emitter nor receiver is chosen."""
+    result = await hass.config_entries.flow.async_init(
+        DOMAIN, context={"source": SOURCE_USER}
+    )
+    result = await hass.config_entries.flow.async_configure(
+        result["flow_id"], user_input={}
+    )
+
+    assert result["type"] is FlowResultType.FORM
+    assert result["errors"] == {"base": "missing_infrared_entity"}
+
+    result = await hass.config_entries.flow.async_configure(
+        result["flow_id"], user_input={CONF_INFRARED_ENTITY_ID: EMITTER_ENTITY_ID}
+    )
+    assert result["type"] is FlowResultType.CREATE_ENTRY
+
+
+@pytest.mark.usefixtures("init_infrared")
+async def test_user_flow_no_infrared_entities(hass: HomeAssistant) -> None:
+    """Test the flow aborts when there are no infrared entities."""
+    result = await hass.config_entries.flow.async_init(
+        DOMAIN, context={"source": SOURCE_USER}
+    )
+
+    assert result["type"] is FlowResultType.ABORT
+    assert result["reason"] == "no_infrared_entities"
+
+
+@pytest.mark.parametrize(
+    "user_input",
+    [
+        pytest.param({CONF_INFRARED_ENTITY_ID: EMITTER_ENTITY_ID}, id="emitter"),
+        pytest.param(
+            {CONF_INFRARED_RECEIVER_ENTITY_ID: RECEIVER_ENTITY_ID}, id="receiver"
+        ),
+    ],
+)
+@pytest.mark.usefixtures(
+    "mock_infrared_emitter_entity", "mock_infrared_receiver_entity", "mock_setup_entry"
+)
+async def test_user_flow_already_configured(
+    hass: HomeAssistant,
+    mock_config_entry: MockConfigEntry,
+    user_input: dict[str, str],
+) -> None:
+    """Test the flow aborts when an infrared entity is already in use."""
+    mock_config_entry.add_to_hass(hass)
+
+    result = await hass.config_entries.flow.async_init(
+        DOMAIN, context={"source": SOURCE_USER}
+    )
+    result = await hass.config_entries.flow.async_configure(
+        result["flow_id"], user_input=user_input
+    )
+
+    assert result["type"] is FlowResultType.ABORT
+    assert result["reason"] == "already_configured"
+
+
+@pytest.mark.usefixtures(
+    "mock_infrared_emitter_entity", "mock_infrared_receiver_entity", "mock_setup_entry"
+)
+async def test_reconfigure_flow(
+    hass: HomeAssistant, mock_config_entry: MockConfigEntry
+) -> None:
+    """Test changing the emitter and dropping the receiver."""
+    await hass.data[INFRARED_DATA_COMPONENT].async_add_entities(
+        [MockInfraredEmitterEntity("second_ir_emitter", "Second IR emitter")]
+    )
+    mock_config_entry.add_to_hass(hass)
+
+    result = await mock_config_entry.start_reconfigure_flow(hass)
+    assert result["type"] is FlowResultType.FORM
+    assert result["step_id"] == "reconfigure"
+    assert (
+        get_schema_suggested_value(
+            result["data_schema"].schema, CONF_INFRARED_ENTITY_ID
+        )
+        == EMITTER_ENTITY_ID
+    )
+
+    result = await hass.config_entries.flow.async_configure(
+        result["flow_id"],
+        user_input={CONF_INFRARED_ENTITY_ID: SECOND_EMITTER_ENTITY_ID},
+    )
+
+    assert result["type"] is FlowResultType.ABORT
+    assert result["reason"] == "reconfigure_successful"
+    assert mock_config_entry.data == {CONF_INFRARED_ENTITY_ID: SECOND_EMITTER_ENTITY_ID}
+
+
+@pytest.mark.usefixtures(
+    "mock_infrared_emitter_entity", "mock_infrared_receiver_entity", "mock_setup_entry"
+)
+async def test_reconfigure_flow_keeps_own_entities(
+    hass: HomeAssistant, mock_config_entry: MockConfigEntry
+) -> None:
+    """Test reconfiguring with unchanged entities does not abort as a duplicate."""
+    mock_config_entry.add_to_hass(hass)
+
+    result = await mock_config_entry.start_reconfigure_flow(hass)
+    result = await hass.config_entries.flow.async_configure(
+        result["flow_id"], user_input=dict(mock_config_entry.data)
+    )
+
+    assert result["type"] is FlowResultType.ABORT
+    assert result["reason"] == "reconfigure_successful"
+
+
+@pytest.mark.usefixtures(
+    "mock_infrared_emitter_entity", "mock_infrared_receiver_entity", "mock_setup_entry"
+)
+async def test_reconfigure_flow_requires_emitter_or_receiver(
+    hass: HomeAssistant, mock_config_entry: MockConfigEntry
+) -> None:
+    """Test reconfigure shows an error when both entities are cleared."""
+    mock_config_entry.add_to_hass(hass)
+
+    result = await mock_config_entry.start_reconfigure_flow(hass)
+    result = await hass.config_entries.flow.async_configure(
+        result["flow_id"], user_input={}
+    )
+
+    assert result["type"] is FlowResultType.FORM
+    assert result["errors"] == {"base": "missing_infrared_entity"}
+
+    result = await hass.config_entries.flow.async_configure(
+        result["flow_id"],
+        user_input={CONF_INFRARED_RECEIVER_ENTITY_ID: RECEIVER_ENTITY_ID},
+    )
+    assert result["type"] is FlowResultType.ABORT
+    assert result["reason"] == "reconfigure_successful"
+    assert mock_config_entry.data == {
+        CONF_INFRARED_RECEIVER_ENTITY_ID: RECEIVER_ENTITY_ID
+    }
+
+
+@pytest.mark.usefixtures(
+    "mock_infrared_emitter_entity", "mock_infrared_receiver_entity", "mock_setup_entry"
+)
+async def test_reconfigure_flow_already_configured(
+    hass: HomeAssistant, mock_config_entry: MockConfigEntry
+) -> None:
+    """Test reconfigure aborts when the emitter is used by another entry."""
+    mock_config_entry.add_to_hass(hass)
+    other_entry = MockConfigEntry(
+        domain=DOMAIN, data={CONF_INFRARED_RECEIVER_ENTITY_ID: RECEIVER_ENTITY_ID}
+    )
+    other_entry.add_to_hass(hass)
+
+    result = await other_entry.start_reconfigure_flow(hass)
+    result = await hass.config_entries.flow.async_configure(
+        result["flow_id"], user_input={CONF_INFRARED_ENTITY_ID: EMITTER_ENTITY_ID}
+    )
+
+    assert result["type"] is FlowResultType.ABORT
+    assert result["reason"] == "already_configured"
+
+
+@pytest.mark.usefixtures("init_infrared")
+async def test_reconfigure_flow_no_infrared_entities(
+    hass: HomeAssistant, mock_config_entry: MockConfigEntry
+) -> None:
+    """Test reconfigure aborts when there are no infrared entities."""
+    mock_config_entry.add_to_hass(hass)
+
+    result = await mock_config_entry.start_reconfigure_flow(hass)
+
+    assert result["type"] is FlowResultType.ABORT
+    assert result["reason"] == "no_infrared_entities"
