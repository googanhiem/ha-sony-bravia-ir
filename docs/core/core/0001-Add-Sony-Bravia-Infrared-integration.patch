+"""Button platform for the Sony Bravia Infrared integration."""
+
+from dataclasses import dataclass
+from typing import override
+
+from infrared_protocols.codes.sony.tv import SonyTVCode
+
+from homeassistant.components.button import ButtonEntity, ButtonEntityDescription
+from homeassistant.components.infrared import InfraredEmitterConsumerEntity
+from homeassistant.config_entries import ConfigEntry
+from homeassistant.core import HomeAssistant
+from homeassistant.helpers.entity_platform import AddConfigEntryEntitiesCallback
+
+from .const import CONF_INFRARED_ENTITY_ID
+from .entity import SonyBraviaIrEntity, sirc_command
+
+PARALLEL_UPDATES = 1
+
+# Keys that are less commonly automated, or not present on every remote.
+_DISABLED_BY_DEFAULT = {
+    SonyTVCode.SLEEP,
+    SonyTVCode.NUM_0,
+    SonyTVCode.NUM_1,
+    SonyTVCode.NUM_2,
+    SonyTVCode.NUM_3,
+    SonyTVCode.NUM_4,
+    SonyTVCode.NUM_5,
+    SonyTVCode.NUM_6,
+    SonyTVCode.NUM_7,
+    SonyTVCode.NUM_8,
+    SonyTVCode.NUM_9,
+    SonyTVCode.CHANNEL_DASH,
+    SonyTVCode.ENTER,
+    SonyTVCode.JUMP,
+    SonyTVCode.FAVORITES,
+    SonyTVCode.CLOSED_CAPTIONS,
+    SonyTVCode.AUDIO,
+    SonyTVCode.PICTURE,
+    SonyTVCode.TV,
+    SonyTVCode.HDMI,
+    SonyTVCode.COMPONENT,
+    SonyTVCode.RED,
+    SonyTVCode.GREEN,
+    SonyTVCode.YELLOW,
+    SonyTVCode.BLUE,
+}
+
+
+@dataclass(frozen=True, kw_only=True)
+class SonyBraviaIrButtonEntityDescription(ButtonEntityDescription):
+    """Describes a Sony Bravia Infrared button entity."""
+
+    command_code: SonyTVCode
+
+
+BUTTON_DESCRIPTIONS: tuple[SonyBraviaIrButtonEntityDescription, ...] = tuple(
+    SonyBraviaIrButtonEntityDescription(
+        key=code.name.lower(),
+        translation_key=code.name.lower(),
+        command_code=code,
+        entity_registry_enabled_default=code not in _DISABLED_BY_DEFAULT,
+    )
+    for code in SonyTVCode
+)
+
+
+async def async_setup_entry(
+    hass: HomeAssistant,
+    entry: ConfigEntry,
+    async_add_entities: AddConfigEntryEntitiesCallback,
+) -> None:
+    """Set up Sony Bravia Infrared buttons from a config entry."""
+    if not (infrared_entity_id := entry.data.get(CONF_INFRARED_ENTITY_ID)):
+        return
+    async_add_entities(
+        SonyBraviaIrButton(entry, infrared_entity_id, description)
+        for description in BUTTON_DESCRIPTIONS
+    )
+
+
+class SonyBraviaIrButton(
+    SonyBraviaIrEntity, InfraredEmitterConsumerEntity, ButtonEntity
+):
+    """A key on the Sony TV remote."""
+
+    entity_description: SonyBraviaIrButtonEntityDescription
+
+    def __init__(
+        self,
+        entry: ConfigEntry,
+        infrared_entity_id: str,
+        description: SonyBraviaIrButtonEntityDescription,
+    ) -> None:
+        """Initialize the button."""
+        super().__init__(entry, unique_id_suffix=description.key)
+        self._infrared_emitter_entity_id = infrared_entity_id
+        self.entity_description = description
+
+    @override
+    async def async_press(self) -> None:
+        """Press the button."""
+        await self._send_command(sirc_command(self.entity_description.command_code))
diff --git a/homeassistant/components/sony_bravia_infrared/config_flow.py b/homeassistant/components/sony_bravia_infrared/config_flow.py
new file mode 100644
index 00000000..f42bd15f
--- /dev/null
+++ b/homeassistant/components/sony_bravia_infrared/config_flow.py
@@ -0,0 +1,123 @@
+"""Config flow for the Sony Bravia Infrared integration."""
+
+from typing import TYPE_CHECKING, Any, override
+
+import probatio
+
+from homeassistant.components.infrared import (
+    DOMAIN as INFRARED_DOMAIN,
+    async_get_emitters,
+    async_get_receivers,
+)
+from homeassistant.config_entries import ConfigFlow, ConfigFlowResult
+from homeassistant.core import HomeAssistant, callback
+from homeassistant.helpers import entity_registry as er
+from homeassistant.helpers.selector import EntitySelector, EntitySelectorConfig
+
+from .const import CONF_INFRARED_ENTITY_ID, CONF_INFRARED_RECEIVER_ENTITY_ID, DOMAIN
+
+
+@callback
+def _infrared_entity_schema(hass: HomeAssistant) -> probatio.Schema:
+    """Return the emitter and receiver selection schema."""
+    return probatio.Schema(
+        {
+            probatio.Optional(CONF_INFRARED_ENTITY_ID): EntitySelector(
+                EntitySelectorConfig(
+                    domain=INFRARED_DOMAIN,
+                    include_entities=async_get_emitters(hass),
+                )
+            ),
+            probatio.Optional(CONF_INFRARED_RECEIVER_ENTITY_ID): EntitySelector(
+                EntitySelectorConfig(
+                    domain=INFRARED_DOMAIN,
+                    include_entities=async_get_receivers(hass),
+                )
+            ),
+        }
+    )
+
+
+def _has_infrared_entity(user_input: dict[str, Any]) -> bool:
+    """Return True if an emitter or a receiver was selected."""
+    return bool(
+        user_input.get(CONF_INFRARED_ENTITY_ID)
+        or user_input.get(CONF_INFRARED_RECEIVER_ENTITY_ID)
+    )
+
+
+class SonyBraviaIrConfigFlow(ConfigFlow, domain=DOMAIN):
+    """Handle a config flow for Sony Bravia Infrared."""
+
+    @callback
+    def _async_has_infrared_entities(self) -> bool:
+        """Return True if any infrared emitter or receiver exists."""
+        return bool(async_get_emitters(self.hass) or async_get_receivers(self.hass))
+
+    @callback
+    def _async_abort_infrared_entities_match(self, user_input: dict[str, Any]) -> None:
+        """Abort if another entry already uses one of these infrared entities."""
+        for key in (CONF_INFRARED_ENTITY_ID, CONF_INFRARED_RECEIVER_ENTITY_ID):
+            if entity_id := user_input.get(key):
+                self._async_abort_entries_match({key: entity_id})
+
+    def _entity_name(self, entity_id: str) -> str:
+        """Return the name of an infrared entity for the entry title."""
+        entry = er.async_get(self.hass).async_get(entity_id)
+        if entry is None:
+            return entity_id
+        return entry.name or entry.original_name or entity_id
+
+    @override
+    async def async_step_user(
+        self, user_input: dict[str, Any] | None = None
+    ) -> ConfigFlowResult:
+        """Handle the infrared entity selection."""
+        if not self._async_has_infrared_entities():
+            return self.async_abort(reason="no_infrared_entities")
+
+        errors: dict[str, str] = {}
+        if user_input is not None:
+            if _has_infrared_entity(user_input):
+                self._async_abort_infrared_entities_match(user_input)
+                title_entity_id = user_input.get(
+                    CONF_INFRARED_ENTITY_ID
+                ) or user_input.get(CONF_INFRARED_RECEIVER_ENTITY_ID)
+                if TYPE_CHECKING:
+                    assert title_entity_id is not None
+                return self.async_create_entry(
+                    title=f"Sony Bravia TV via {self._entity_name(title_entity_id)}",
+                    data=user_input,
+                )
+            errors["base"] = "missing_infrared_entity"
+
+        return self.async_show_form(
+            step_id="user",
+            data_schema=_infrared_entity_schema(self.hass),
+            errors=errors,
+        )
+
+    async def async_step_reconfigure(
+        self, user_input: dict[str, Any] | None = None
+    ) -> ConfigFlowResult:
+        """Handle reconfiguration of the infrared entities."""
+        entry = self._get_reconfigure_entry()
+        if not self._async_has_infrared_entities():
+            return self.async_abort(reason="no_infrared_entities")
+
+        errors: dict[str, str] = {}
+        if user_input is not None:
+            if _has_infrared_entity(user_input):
+                self._async_abort_infrared_entities_match(user_input)
+                # Replace rather than update the data, so a cleared optional
+                # selector removes that entity from the entry.
+                return self.async_update_reload_and_abort(entry, data=user_input)
+            errors["base"] = "missing_infrared_entity"
+
+        return self.async_show_form(
+            step_id="reconfigure",
+            data_schema=self.add_suggested_values_to_schema(
+                _infrared_entity_schema(self.hass), entry.data
+            ),
+            errors=errors,
+        )
