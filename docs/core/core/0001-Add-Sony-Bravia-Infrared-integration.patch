@@ -0,0 +1,70 @@
+"""Tests for the Sony Bravia Infrared integration setup."""
+
+import pytest
+from pytest_homeassistant.common import MockConfigEntry
+from pytest_homeassistant.components.infrared import (
+    EMITTER_ENTITY_ID,
+    RECEIVER_ENTITY_ID,
+)
+
+from homeassistant.components.sony_bravia_infrared.const import (
+    CONF_INFRARED_ENTITY_ID,
+    CONF_INFRARED_RECEIVER_ENTITY_ID,
+    DOMAIN,
+)
+from homeassistant.config_entries import ConfigEntryState
+from homeassistant.core import HomeAssistant
+from homeassistant.helpers import entity_registry as er
+
+
+async def test_setup_and_unload_entry(
+    hass: HomeAssistant, init_integration: MockConfigEntry
+) -> None:
+    """Test setting up and unloading a config entry."""
+    entry = init_integration
+    assert entry.state is ConfigEntryState.LOADED
+
+    await hass.config_entries.async_unload(entry.entry_id)
+    await hass.async_block_till_done()
+
+    assert entry.state is ConfigEntryState.NOT_LOADED
+
+
+@pytest.mark.parametrize(
+    ("data", "expected_domains"),
+    [
+        pytest.param(
+            {CONF_INFRARED_ENTITY_ID: EMITTER_ENTITY_ID},
+            {"button", "media_player"},
+            id="emitter_only",
+        ),
+        pytest.param(
+            {CONF_INFRARED_RECEIVER_ENTITY_ID: RECEIVER_ENTITY_ID},
+            {"event"},
+            id="receiver_only",
+        ),
+    ],
+)
+@pytest.mark.usefixtures(
+    "mock_infrared_emitter_entity", "mock_infrared_receiver_entity"
+)
+async def test_entities_follow_configured_infrared_entities(
+    hass: HomeAssistant,
+    entity_registry: er.EntityRegistry,
+    data: dict[str, str],
+    expected_domains: set[str],
+) -> None:
+    """Test only the platforms backed by a configured infrared entity add entities."""
+    entry = MockConfigEntry(domain=DOMAIN, data=data)
+    entry.add_to_hass(hass)
+
+    await hass.config_entries.async_setup(entry.entry_id)
+    await hass.async_block_till_done()
+
+    assert entry.state is ConfigEntryState.LOADED
+    assert {
+        entity_entry.domain
+        for entity_entry in er.async_entries_for_config_entry(
+            entity_registry, entry.entry_id
+        )
+    } == expected_domains
