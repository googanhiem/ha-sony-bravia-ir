diff --git a/tests/components/sony_bravia_infrared/test_event.py b/tests/components/sony_bravia_infrared/test_event.py
new file mode 100644
index 00000000..9ca0593f
--- /dev/null
+++ b/tests/components/sony_bravia_infrared/test_event.py
@@ -0,0 +1,198 @@
+"""Tests for the Sony Bravia Infrared event platform."""
+
+from datetime import timedelta
+
+from freezegun.api import FrozenDateTimeFactory
+from infrared_protocols.codes.sony.tv import SonyTVCode
+from infrared_protocols.commands.sony import SonyCommand
+import pytest
+from pytest_homeassistant.common import MockConfigEntry, snapshot_platform
+from pytest_homeassistant.components.common import (
+    assert_availability_follows_source_entity,
+)
+from pytest_homeassistant.components.infrared import RECEIVER_ENTITY_ID
+from pytest_homeassistant.components.infrared.common import MockInfraredReceiverEntity
+from syrupy.assertion import SnapshotAssertion
+
+from homeassistant.components.event import EventEntityStateAttribute
+from homeassistant.components.infrared import InfraredReceivedSignal
+from homeassistant.const import STATE_UNKNOWN, Platform
+from homeassistant.core import HomeAssistant
+from homeassistant.helpers import entity_registry as er
+from homeassistant.util import dt as dt_util
+
+EVENT_ENTITY_ID = "event.sony_bravia_tv_received_command"
+NOW = dt_util.parse_datetime("2026-11-16 12:00:00+00:00")
+
+
+def _send(
+    receiver: MockInfraredReceiverEntity,
+    command: int,
+    *,
+    address: int = 0x01,
+    address_bits: int = 5,
+    repeat_count: int = 2,
+) -> None:
+    """Feed a Sony SIRC key press to the mock receiver."""
+    sony_command = SonyCommand(
+        address=address,
+        address_bits=address_bits,
+        command=command,
+        repeat_count=repeat_count,
+    )
+    receiver._handle_received_signal(
+        InfraredReceivedSignal(timings=sony_command.get_raw_timings())
+    )
+
+
+@pytest.fixture
+def platforms() -> list[Platform]:
+    """Return platforms to set up."""
+    return [Platform.EVENT]
+
+
+@pytest.fixture(autouse=True)
+def frozen_time(freezer: FrozenDateTimeFactory) -> FrozenDateTimeFactory:
+    """Freeze time so event timestamps are predictable."""
+    assert NOW is not None
+    freezer.move_to(NOW)
+    return freezer
+
+
+@pytest.mark.usefixtures("init_integration")
+async def test_entities(
+    hass: HomeAssistant,
+    snapshot: SnapshotAssertion,
+    entity_registry: er.EntityRegistry,
+    mock_config_entry: MockConfigEntry,
+) -> None:
+    """Test the event entity is created with the expected attributes."""
+    await snapshot_platform(hass, entity_registry, snapshot, mock_config_entry.entry_id)
+
+
+@pytest.mark.parametrize(
+    ("command", "expected_event_type"),
+    [
+        (SonyTVCode.POWER, "power"),
+        (SonyTVCode.VOLUME_UP, "volume_up"),
+        (SonyTVCode.NAV_UP, "nav_up"),
+        (SonyTVCode.NUM_0, "num_0"),
+        (SonyTVCode.CLOSED_CAPTIONS, "closed_captions"),
+        (0x2E, "unknown"),
+    ],
+)
+@pytest.mark.usefixtures("init_integration")
+async def test_event_fires(
+    hass: HomeAssistant,
+    mock_infrared_receiver_entity: MockInfraredReceiverEntity,
+    command: int,
+    expected_event_type: str,
+) -> None:
+    """Test the event entity fires the expected event type."""
+    _send(mock_infrared_receiver_entity, command)
+    await hass.async_block_till_done()
+
+    state = hass.states.get(EVENT_ENTITY_ID)
+    assert state is not None
+    assert NOW is not None
+    assert state.state == NOW.isoformat(timespec="milliseconds")
+    assert state.attributes[EventEntityStateAttribute.EVENT_TYPE] == expected_event_type
+
+
+@pytest.mark.parametrize(
+    "signal_kwargs",
+    [
+        pytest.param({"address": 0x02}, id="other_address"),
+        pytest.param({"address": 0x01, "address_bits": 8}, id="15_bit_frame"),
+    ],
+)
+@pytest.mark.usefixtures("init_integration")
+async def test_event_ignores_other_devices(
+    hass: HomeAssistant,
+    mock_infrared_receiver_entity: MockInfraredReceiverEntity,
+    signal_kwargs: dict[str, int],
+) -> None:
+    """Test the event entity ignores SIRC frames meant for other devices."""
+    _send(mock_infrared_receiver_entity, SonyTVCode.POWER, **signal_kwargs)
+    await hass.async_block_till_done()
+
+    state = hass.states.get(EVENT_ENTITY_ID)
+    assert state is not None
+    assert state.state == STATE_UNKNOWN
+
+
+@pytest.mark.usefixtures("init_integration")
+async def test_event_ignores_non_sirc_signals(
+    hass: HomeAssistant,
+    mock_infrared_receiver_entity: MockInfraredReceiverEntity,
+) -> None:
+    """Test the event entity ignores signals that cannot be decoded as SIRC."""
+    mock_infrared_receiver_entity._handle_received_signal(
+        InfraredReceivedSignal(timings=[1, 2, 3, 4])
+    )
+    await hass.async_block_till_done()
+
+    state = hass.states.get(EVENT_ENTITY_ID)
+    assert state is not None
+    assert state.state == STATE_UNKNOWN
+
+
+@pytest.mark.usefixtures("init_integration")
+async def test_held_key_fires_once(
+    hass: HomeAssistant,
+    mock_infrared_receiver_entity: MockInfraredReceiverEntity,
+    frozen_time: FrozenDateTimeFactory,
+) -> None:
+    """Test frames repeated while a key is held fire a single event."""
+    _send(mock_infrared_receiver_entity, SonyTVCode.VOLUME_UP, repeat_count=0)
+    await hass.async_block_till_done()
+    first_state = hass.states.get(EVENT_ENTITY_ID)
+    assert first_state is not None
+
+    for _ in range(5):
+        frozen_time.tick(timedelta(milliseconds=45))
+        _send(mock_infrared_receiver_entity, SonyTVCode.VOLUME_UP, repeat_count=0)
+        await hass.async_block_till_done()
+
+    state = hass.states.get(EVENT_ENTITY_ID)
+    assert state is not None
+    assert state.state == first_state.state
+
+    # A different key right after fires straight away.
+    _send(mock_infrared_receiver_entity, SonyTVCode.MUTE, repeat_count=0)
+    await hass.async_block_till_done()
+    state = hass.states.get(EVENT_ENTITY_ID)
+    assert state is not None
+    assert state.attributes[EventEntityStateAttribute.EVENT_TYPE] == "mute"
+
+
+@pytest.mark.usefixtures("init_integration")
+async def test_separate_presses_fire_twice(
+    hass: HomeAssistant,
+    mock_infrared_receiver_entity: MockInfraredReceiverEntity,
+    frozen_time: FrozenDateTimeFactory,
+) -> None:
+    """Test two presses of the same key with a pause between fire two events."""
+    _send(mock_infrared_receiver_entity, SonyTVCode.VOLUME_UP)
+    await hass.async_block_till_done()
+    first_state = hass.states.get(EVENT_ENTITY_ID)
+    assert first_state is not None
+
+    frozen_time.tick(timedelta(seconds=1))
+    _send(mock_infrared_receiver_entity, SonyTVCode.VOLUME_UP)
+    await hass.async_block_till_done()
+
+    state = hass.states.get(EVENT_ENTITY_ID)
+    assert state is not None
+    assert state.state != first_state.state
+    assert state.attributes[EventEntityStateAttribute.EVENT_TYPE] == "volume_up"
+
+
+@pytest.mark.usefixtures("init_integration")
+async def test_event_availability_follows_ir_entity(
+    hass: HomeAssistant,
+) -> None:
+    """Test the event entity becomes unavailable when the receiver is unavailable."""
+    await assert_availability_follows_source_entity(
+        hass, EVENT_ENTITY_ID, [RECEIVER_ENTITY_ID]
+    )
