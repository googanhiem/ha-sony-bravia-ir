@@ -0,0 +1,36 @@
+"""Common entity for the Sony Bravia Infrared integration."""
+
+from infrared_protocols.codes.sony.tv import SonyTVCode
+from infrared_protocols.commands import Command
+
+from homeassistant.config_entries import ConfigEntry
+from homeassistant.helpers.device_registry import DeviceInfo
+from homeassistant.helpers.entity import Entity
+
+from .const import DOMAIN
+
+# A key press on a Sony remote sends at least three identical frames, and some
+# sets ignore a single frame.
+SIRC_REPEAT_COUNT = 2
+
+
+def sirc_command(code: SonyTVCode) -> Command:
+    """Return the IR command for a key press of a Sony TV code."""
+    command = code.to_command()
+    command.repeat_count = SIRC_REPEAT_COUNT
+    return command
+
+
+class SonyBraviaIrEntity(Entity):
+    """Sony Bravia Infrared base entity providing common device info."""
+
+    _attr_has_entity_name = True
+
+    def __init__(self, entry: ConfigEntry, unique_id_suffix: str) -> None:
+        """Initialize the entity."""
+        self._attr_unique_id = f"{entry.entry_id}_{unique_id_suffix}"
+        self._attr_device_info = DeviceInfo(
+            identifiers={(DOMAIN, entry.entry_id)},
+            name="Sony Bravia TV",
+            manufacturer="Sony",
+        )
diff --git a/homeassistant/components/sony_bravia_infrared/event.py b/homeassistant/components/sony_bravia_infrared/event.py
new file mode 100644
index 00000000..bdae7081
--- /dev/null
+++ b/homeassistant/components/sony_bravia_infrared/event.py
@@ -0,0 +1,100 @@
+"""Event platform for the Sony Bravia Infrared integration."""
+
+import logging
+import time
+from typing import override
+
+from infrared_protocols.codes.sony.tv import (
+    SONY_TV_ADDRESS,
+    SONY_TV_ADDRESS_BITS,
+    SonyTVCode,
+)
+from infrared_protocols.commands.sony import SonyCommand
+
+from homeassistant.components.event import EventEntity
+from homeassistant.components.infrared import (
+    InfraredReceivedSignal,
+    InfraredReceiverConsumerEntity,
+)
+from homeassistant.config_entries import ConfigEntry
+from homeassistant.core import HomeAssistant, callback
+from homeassistant.helpers.entity_platform import AddConfigEntryEntitiesCallback
+
+from .const import CONF_INFRARED_RECEIVER_ENTITY_ID
+from .entity import SonyBraviaIrEntity
+
+_LOGGER = logging.getLogger(__name__)
+
+PARALLEL_UPDATES = 0
+
+_EVENT_TYPE_UNKNOWN = "unknown"
+_EVENT_TYPES: list[str] = [
+    *(code.name.lower() for code in SonyTVCode),
+    _EVENT_TYPE_UNKNOWN,
+]
+
+# A Sony remote repeats the frame every 45 ms while a key is held, and many
+# receivers report each frame as its own signal.
+_REPEAT_WINDOW = 0.2
+
+
+async def async_setup_entry(
+    hass: HomeAssistant,
+    entry: ConfigEntry,
+    async_add_entities: AddConfigEntryEntitiesCallback,
+) -> None:
+    """Set up the Sony Bravia Infrared event entity from a config entry."""
+    if not (receiver_entity_id := entry.data.get(CONF_INFRARED_RECEIVER_ENTITY_ID)):
+        return
+    async_add_entities([SonyBraviaIrReceivedCommandEvent(entry, receiver_entity_id)])
+
+
+class SonyBraviaIrReceivedCommandEvent(
+    SonyBraviaIrEntity, InfraredReceiverConsumerEntity, EventEntity
+):
+    """Event entity that fires when a Sony TV remote key is received."""
+
+    _attr_translation_key = "received_command"
+    _attr_event_types = _EVENT_TYPES
+
+    def __init__(self, entry: ConfigEntry, receiver_entity_id: str) -> None:
+        """Initialize the event entity."""
+        super().__init__(entry, unique_id_suffix="received_command")
+        self._infrared_receiver_entity_id = receiver_entity_id
+        self._last_command: int | None = None
+        self._last_command_time = 0.0
+
+    @callback
+    @override
+    def _handle_signal(self, signal: InfraredReceivedSignal) -> None:
+        """Handle a received IR signal."""
+        sony_command = SonyCommand.from_raw_timings(signal.timings)
+        if (
+            sony_command is None
+            or sony_command.address != SONY_TV_ADDRESS
+            or sony_command.address_bits != SONY_TV_ADDRESS_BITS
+        ):
+            return
+
+        now = time.monotonic()
+        is_repeat = (
+            sony_command.command == self._last_command
+            and now - self._last_command_time < _REPEAT_WINDOW
+        )
+        self._last_command = sony_command.command
+        self._last_command_time = now
+        if is_repeat:
+            return
+
+        try:
+            event_type = SonyTVCode(sony_command.command).name.lower()
+        except ValueError:
+            event_type = _EVENT_TYPE_UNKNOWN
+
+        _LOGGER.debug(
+            "Received Sony TV IR command: %s (0x%02X)",
+            event_type,
+            sony_command.command,
+        )
+        self._trigger_event(event_type)
+        self.async_write_ha_state()
