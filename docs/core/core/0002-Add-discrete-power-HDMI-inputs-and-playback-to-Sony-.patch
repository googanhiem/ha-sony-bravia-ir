@@ -61,40 +64,55 @@ class SonyBraviaIrReceivedCommandEvent(
         """Initialize the event entity."""
         super().__init__(entry, unique_id_suffix="received_command")
         self._infrared_receiver_entity_id = receiver_entity_id
-        self._last_command: int | None = None
-        self._last_command_time = 0.0
+        self._last_frame: tuple[int, int, int] | None = None
+        self._last_frame_time = 0.0
 
     @callback
     @override
     def _handle_signal(self, signal: InfraredReceivedSignal) -> None:
         """Handle a received IR signal."""
         sony_command = SonyCommand.from_raw_timings(signal.timings)
-        if (
-            sony_command is None
-            or sony_command.address != SONY_TV_ADDRESS
-            or sony_command.address_bits != SONY_TV_ADDRESS_BITS
-        ):
+        if sony_command is None or (event_type := _event_type(sony_command)) is None:
             return
 
+        frame = (
+            sony_command.address,
+            sony_command.address_bits,
+            sony_command.command,
+        )
         now = time.monotonic()
         is_repeat = (
-            sony_command.command == self._last_command
-            and now - self._last_command_time < _REPEAT_WINDOW
+            frame == self._last_frame and now - self._last_frame_time < _REPEAT_WINDOW
         )
-        self._last_command = sony_command.command
-        self._last_command_time = now
+        self._last_frame = frame
+        self._last_frame_time = now
         if is_repeat:
             return
 
-        try:
-            event_type = SonyTVCode(sony_command.command).name.lower()
-        except ValueError:
-            event_type = _EVENT_TYPE_UNKNOWN
-
         _LOGGER.debug(
-            "Received Sony TV IR command: %s (0x%02X)",
+            "Received Sony TV IR command: %s (address 0x%02X, command 0x%02X)",
             event_type,
+            sony_command.address,
             sony_command.command,
         )
         self._trigger_event(event_type)
         self.async_write_ha_state()
+
+
+def _event_type(sony_command: SonyCommand) -> str | None:
+    """Return the event type of a Sony TV key, or None for other devices."""
+    if sony_command.address_bits == SONY_TV_EXTENDED_ADDRESS_BITS:
+        try:
+            code = SonyTVExtendedCode((sony_command.address, sony_command.command))
+        except ValueError:
+            return None
+        return code.name.lower()
+    if (
+        sony_command.address != SONY_TV_ADDRESS
+        or sony_command.address_bits != SONY_TV_ADDRESS_BITS
+    ):
+        return None
+    try:
+        return SonyTVCode(sony_command.command).name.lower()
+    except ValueError:
+        return _EVENT_TYPE_UNKNOWN
