+    ("code", "expected_source"),
+    [
+        (SonyTVExtendedCode.HDMI_2, "HDMI 2"),
+        (SonyTVExtendedCode.HDMI_4, "HDMI 4"),
+        (SonyTVCode.TV, "TV"),
+        (SonyTVCode.INPUT, None),
+        (SonyTVCode.HDMI, None),
+        (SonyTVCode.COMPONENT, None),
+        (SonyTVCode.VOLUME_UP, "HDMI 1"),
+    ],
+)
+@pytest.mark.usefixtures("init_integration")
+async def test_remote_source_keys(
+    hass: HomeAssistant,
+    mock_infrared_receiver_entity: MockInfraredReceiverEntity,
+    freezer: FrozenDateTimeFactory,
+    code: SonyTVCode | SonyTVExtendedCode,
+    expected_source: str | None,
+) -> None:
+    """Test remote input keys update or clear the source, and other keys don't."""
+    await _call(hass, SERVICE_TURN_ON)
+    await _call(hass, SERVICE_SELECT_SOURCE, **{ATTR_INPUT_SOURCE: "HDMI 1"})
+
+    _press(mock_infrared_receiver_entity, freezer, code)
+    await hass.async_block_till_done()
+
+    state = hass.states.get(MEDIA_PLAYER_ENTITY_ID)
+    assert state is not None
+    assert state.state == MediaPlayerState.ON
+    assert state.attributes.get(ATTR_INPUT_SOURCE) == expected_source
+
