@@ -48,7 +60,8 @@ class SonyBraviaIrMediaPlayer(
     """Sony Bravia TV controlled over infrared.
 
     The TV never reports back, so the power state and source are assumed from
-    the last command sent and restored across restarts.
+    the last command sent, or the last key received from the remote, and
+    restored across restarts.
     """
 
     _attr_name = None
@@ -72,11 +85,17 @@ class SonyBraviaIrMediaPlayer(
         """Initialize the media player."""
         super().__init__(entry, unique_id_suffix="media_player")
         self._infrared_emitter_entity_id = infrared_entity_id
+        self._signal = SIGNAL_RECEIVED_COMMAND.format(entry.entry_id)
 
     @override
     async def async_added_to_hass(self) -> None:
-        """Restore the assumed power state and source."""
+        """Restore the assumed state and follow keys received from the remote."""
         await super().async_added_to_hass()
+        self.async_on_remove(
+            async_dispatcher_connect(
+                self.hass, self._signal, self._async_handle_received_command
+            )
+        )
         if (last_state := await self.async_get_last_state()) is None:
             return
         if last_state.state in (MediaPlayerState.ON, MediaPlayerState.OFF):
@@ -84,6 +103,27 @@ class SonyBraviaIrMediaPlayer(
         if (source := last_state.attributes.get("source")) in SOURCES:
             self._attr_source = source
 
+    @callback
+    def _async_handle_received_command(self, event_type: str) -> None:
+        """Update the assumed state from a key pressed on the remote."""
+        if event_type == "power_on":
+            self._attr_state = MediaPlayerState.ON
+        elif event_type == "power_off":
+            self._attr_state = MediaPlayerState.OFF
+        elif event_type == "power":
+            # A toggle from an unknown state could go either way.
+            if self._attr_state == MediaPlayerState.ON:
+                self._attr_state = MediaPlayerState.OFF
+            elif self._attr_state == MediaPlayerState.OFF:
+                self._attr_state = MediaPlayerState.ON
+        elif (source := _EVENT_TYPE_TO_SOURCE.get(event_type)) is not None:
+            self._attr_source = source
+        elif event_type in _SOURCE_CYCLING_EVENT_TYPES:
+            self._attr_source = None
+        else:
+            return
+        self.async_write_ha_state()
+
     async def _send_code(self, code: SonyTVCode | SonyTVExtendedCode) -> None:
         """Send a Sony TV code."""
         await self._send_command(sirc_command(code))
