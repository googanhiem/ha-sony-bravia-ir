+def _press(
+    receiver: MockInfraredReceiverEntity,
+    freezer: FrozenDateTimeFactory,
+    code: SonyTVCode | SonyTVExtendedCode,
+) -> None:
+    """Press a key on the physical remote, far enough apart to not be a repeat."""
+    freezer.tick(timedelta(seconds=1))
+    command = code.to_command(repeat_count=2)
+    assert isinstance(command, SonyCommand)
+    receiver._handle_received_signal(
+        InfraredReceivedSignal(timings=command.get_raw_timings())
+    )
+
+
+async def _call(hass: HomeAssistant, service: str, **data: str) -> None:
+    """Call a media player action on the TV."""
+    await hass.services.async_call(
+        MEDIA_PLAYER_DOMAIN,
+        service,
+        {ATTR_ENTITY_ID: MEDIA_PLAYER_ENTITY_ID, **data},
+        blocking=True,
+    )
+
+
+@pytest.mark.parametrize("platforms", [[Platform.EVENT, Platform.MEDIA_PLAYER]])
+@pytest.mark.parametrize(
+    ("code", "expected_state"),
+    [
+        (SonyTVCode.POWER_ON, MediaPlayerState.ON),
+        (SonyTVCode.POWER_OFF, MediaPlayerState.OFF),
+        (SonyTVCode.POWER, STATE_UNKNOWN),
+    ],
+)
+@pytest.mark.usefixtures("init_integration")
+async def test_remote_power_from_unknown(
+    hass: HomeAssistant,
+    mock_infrared_receiver_entity: MockInfraredReceiverEntity,
+    freezer: FrozenDateTimeFactory,
+    code: SonyTVCode,
+    expected_state: str,
+) -> None:
+    """Test remote power keys update an unknown state, except the toggle."""
+    _press(mock_infrared_receiver_entity, freezer, code)
+    await hass.async_block_till_done()
+
+    state = hass.states.get(MEDIA_PLAYER_ENTITY_ID)
+    assert state is not None
+    assert state.state == expected_state
+
+
+@pytest.mark.parametrize("platforms", [[Platform.EVENT, Platform.MEDIA_PLAYER]])
+@pytest.mark.usefixtures("init_integration")
+async def test_remote_power_toggle_flips_known_state(
+    hass: HomeAssistant,
+    mock_infrared_receiver_entity: MockInfraredReceiverEntity,
+    freezer: FrozenDateTimeFactory,
+) -> None:
+    """Test the remote power toggle flips a known power state."""
+    await _call(hass, SERVICE_TURN_ON)
+
+    _press(mock_infrared_receiver_entity, freezer, SonyTVCode.POWER)
+    await hass.async_block_till_done()
+    state = hass.states.get(MEDIA_PLAYER_ENTITY_ID)
+    assert state is not None
+    assert state.state == MediaPlayerState.OFF
+
+    _press(mock_infrared_receiver_entity, freezer, SonyTVCode.POWER)
+    await hass.async_block_till_done()
+    state = hass.states.get(MEDIA_PLAYER_ENTITY_ID)
+    assert state is not None
+    assert state.state == MediaPlayerState.ON
+
+
+@pytest.mark.parametrize("platforms", [[Platform.EVENT, Platform.MEDIA_PLAYER]])
