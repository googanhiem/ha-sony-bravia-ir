+# Received keys that select a known source.
+_EVENT_TYPE_TO_SOURCE = {
+    "tv": "TV",
+    "hdmi_1": "HDMI 1",
+    "hdmi_2": "HDMI 2",
+    "hdmi_3": "HDMI 3",
